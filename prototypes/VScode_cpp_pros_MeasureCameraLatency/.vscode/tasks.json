{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PROS Terminal",
            "type": "shell",
            "command": "pros terminal",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "PROS Build",
            "type": "shell",
            "command": "pros make",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "PROS Upload",
            "type": "shell",
            "command": "pros upload",
            "dependsOn": "PROS Build",
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}